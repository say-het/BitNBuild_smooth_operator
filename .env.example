# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL/PostGIS. Port 5433 matches the included Docker Compose service.
DATABASE_URL=postgresql://resqai:resqai_dev@localhost:5433/resqai?schema=public
REDIS_URL=redis://localhost:6379
REALTIME_REDIS_ENABLED=false
REALTIME_REDIS_CONNECT_TIMEOUT_MS=1500
REALTIME_LOCATION_THROTTLE_MS=1000

# AI — provide a real key locally; never commit it
GEMINI_API_KEY=
# Explicitly configure a model available to your Gemini project, for example gemini-2.5-flash.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=20000

# Web and mapping
CLIENT_URL=http://localhost:5173
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=5000
ROUTE_CACHE_TTL_SECONDS=60
ROUTING_FALLBACK_SPEED_KPH=30
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
GDACS_EVENTS_URL=https://www.gdacs.org/gdacsapi/api/Events/geteventlist/EVENTS4APP
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
OPTIMIZER_URL=http://127.0.0.1:8081
OPTIMIZER_TIMEOUT_MS=3000

# Synthetic/demo monitoring thresholds. These are not government or medical standards.
MONITORING_ENABLED=true
MONITORING_INTERVAL_MS=30000
SLA_P0_MINUTES=10
SLA_P1_MINUTES=20
SLA_P2_MINUTES=35
SLA_P3_MINUTES=60
ASSESSING_STALL_MINUTES=15
RESOURCE_RECOMMENDED_STALL_MINUTES=10
RESOURCE_ASSIGNED_STALL_MINUTES=10
ON_SCENE_STALL_MINUTES=60
EN_ROUTE_GRACE_MINUTES=5
HOSPITAL_CAPACITY_THRESHOLD_PERCENT=10
ESCALATION_ENABLED=true
ESCALATION_DELAY_MINUTES=10

# Vite exposes only VITE_ prefixed values to browser code
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
